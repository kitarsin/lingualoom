{
  "manifest_version": 3,
  "name": "LinguaLoom",
  "version": "0.1.0",
  "description": "Bring your own key for literary translation on Wattpad chapters.",
  "action": {
    "default_title": "LinguaLoom",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://openrouter.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://wattpad.com/*", "https://www.wattpad.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
